# Never bake secrets into the image
.env
.env.*

# Python caches and virtual environments
__pycache__/
*.pyc
*.pyo
.venv/
backend/.venv/

# Node development artifacts. The frontend dist is built inside Docker
# (see the frontend-build stage), so a local ./frontend/dist is not just
# redundant - shipping it in the build context breaks the build.
frontend/node_modules/
frontend/.vite/
frontend/dist/

# Git and tooling
.git/
.gitignore
.claude/

# Test artefacts
test/
backend/tests/
*.log

# macOS
.DS_Store

# IDE / editor
.idea/
.vscode/
*.swp
